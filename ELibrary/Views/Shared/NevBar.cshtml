<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~\Content\NevBar.css" /> <!-- הוספת קובץ CSS -->
    <title>@ViewBag.Title ELibrary</title>
    @Styles.Render("~/Content/NevBar.css")
</head>
<body>
    <nav class="navbar navbar-expand-sm">
        <div class="search-bar">
            <input type="text" placeholder="Type Something..." />
            <button class="search-button">🔍</button>
        </div>
        <ul class="nav-links">
            <li>@Html.ActionLink("Home", "HomePage", "MainLibrary", new { area = "" }, new { @class = "nav-link" })</li>
            <!--<li>@Html.ActionLink("About", "About", "Profile", new { area = "" }, new { @class = "nav-link" })</li>
            <li>@Html.ActionLink("Profile", "UserProfile", "Profile", new { area = "" }, new { @class = "nav-link" })</li> -->
        </ul>
    </nav>
    <div>
        @RenderBody()
    </div>
</body>
</html>

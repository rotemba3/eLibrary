@model IEnumerable<ELibrary.Models.Books>
@{
    ViewBag.Title = "Library";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Library</title>
    <link rel="stylesheet" href="~\Content\Library_Style.css" /> <!-- הוספת קובץ CSS -->
</head>
<body>
    <div class="introduction">
        <h1>Welcome to our library!</h1>
        <h3>Using our site, you can buy and borrow books of your choosing</h3>
    </div>
        <div class="book-list">
            @if (Model != null && Model.Any())
            {
                foreach (var book in Model)
                {
                    <div class="book-item">
                        <h3>@Html.ActionLink(book.Title, "Details", "MainLibrary", new { ISBN = book.ISBN }, new {@class = "Title-link"})</h3>
                        <p>Author: @book.Authors</p>
                        @if (book.PriceDecrease > 0) //there is a sale
                        {
                            <p>Price: ₪<del>@book.Price</del> @(book.Price - (book.Price * (book.PriceDecrease * 0.01)))</p>
                        }
                        else
                        { <p>Price: ₪@book.Price</p>}
                        <p>Genre: @book.Genre</p>
                        <p>Description: @book.Desrip</p> <!--does not need to buy here-->
                    </div>
                    <div class="Buy&Borrow-Button">
                        <button type="submit" class="signup-btn">Buy</button>
                        @if (book.IsBuyOnly == false)
                        {<button type="submit" class="signup-btn">Borrow</button>}
                    </div>
                }
            }
            else
            { <p> The Library is empty.</p>}
        </div>
</body>
</html> 

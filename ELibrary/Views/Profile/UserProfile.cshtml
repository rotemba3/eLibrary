@model ELibrary.Models.User_Profile_info
@{
    Layout = "~/Views/Shared/NavBar.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>UserProfile</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
            color: #333;
        }

        h1, h2 {
            text-align: center;
            color: #4CAF50;
            font-weight: bold;
        }

        .Books-section, .Reviews-section, .Waiting-list {
            margin: 20px auto;
            max-width: 800px;
            padding: 20px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .review-item, .Waiting-item {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #f9f9f9;
        }

            .review-item p, .Waiting-item p {
                margin: 5px 0;
            }

        p {
            font-size: 16px;
            line-height: 1.4;
        }

            p strong {
                font-weight: bold;
                color: #4CAF50;
            }

        select, button, input[type="submit"] {
            margin: 10px 0;
            padding: 10px 15px;
            font-size: 14px;
            border: none;
            border-radius: 4px;
        }

        select {
            background-color: #f4f4f4;
            border: 1px solid #ddd;
        }

        button, input[type="submit"] {
            background-color: #4CAF50;
            color: white;
            cursor: pointer;
        }

            button:hover, input[type="submit"]:hover {
                background-color: #45a049;
            }

        .remove-btn {
            background-color: #f44336;
            color: white;
        }

            .remove-btn:hover {
                background-color: #d32f2f;
            }

        .orange-warning {
            color: orange;
            font-weight: bold;
        }
    </style>

</head>
<body>
    <h1>Welcome, @Model.user</h1>

    <section class="Books-section">
        <!--User books section-->
        <h2>Your Books:</h2>
        @if (Model.personal_books != null && Model.personal_books.Any())
        {
            foreach (var book in Model.personal_books)
            {
                <div class="review-item">
                    <p><strong>Title:</strong>@book.Title</p>
                    <p><strong>Authors:</strong>@book.Authors</p>
                    <p>@book.Cover</p>
                    @if (book.IsBuyOnly == false)
                    {
                        foreach (var borrow in Model.UserLibrary)
                        {
                            if (book.ISBN == borrow.ISBN)
                            {
                                
                                    var date_diff = DateTime.Now - borrow.TimeBorrowed;
                                    var days = date_diff.Days;
                                    if (days < 30)
                                    {
                                        days = 30 - days;
                                        if (days == 5)
                                        {
                                            <p style="color: orange;">שימו לב: נותרו עוד 5 ימים להחזרת הספר!</p>
                                        }
                                        <p>זמן שנותר: @days ימים</p>
                                    }
                                    else
                                    {
                                        <p>הספר כבר אינו זמין להחזרה.</p>
                                    }
                                

                            }
                        }
                    }

                    <form action="@Url.Action("DownloadBook", "Profile")" method="post">
                        <!--to download book format-->
                        <label for="format"><strong>Select format:</strong></label>
                        <select id="format" name="BookFormat" class="BookFormat">
                            <option value="PDF">PDF</option>
                            <option value="Fb2">fb2</option>
                            <option value="Mobi">mobi</option>
                            <option value="epub">epub</option>
                        </select>
                        <input type="submit" value="Download">
                    </form>

                    <form action="@Url.Action("RemoveBookFromUser", "Profile")" method="post" onsubmit="return confirm('Are you sure you want to remove this book?');">
                        @Html.Hidden("ISBN", book.ISBN)
                        <button type="submit" class="remove-btn">Remove</button>
                    </form>
                </div>
            }
        }
        else
        { <p>No reviews avalible.</p> }
    </section>

    <section class="Reviews-section">
        <!-- Reviews Section -->
        <h2>Your Reviews</h2>
        @if (Model.reviews != null && Model.reviews.Any())
        {
            foreach (var review in Model.reviews)
            {
                <div class="review-item">
                    @foreach (var book in Model.personal_books)
                    {
                        if (review.ISBN == book.ISBN)
                        {
                            <p><strong>Title:</strong>@book.Title</p>
                            <p>@book.Cover</p>
                        }
                    }
                    <p><strong>Rating:</strong>@review.Stars/5</p>
                    <p><strong>Review:</strong>@review.Info</p>
                </div>
            }
        }
        else
        { <p>No reviews avalible.</p>}
    </section>

    <section class="Waiting-list">
        <!-- Wating list Section -->
        <h2>Your Waiting list:</h2>
        @if (Model.waiting_lists != null && Model.waiting_lists.Any()) 
        {
            foreach (var line in Model.waiting_lists) 
            {
                <div class="Waiting-item">
                    <p><strong>Title:</strong> @line.ISBN</p>
                    <p><strong>Place in line:</strong>@line.PlaceInLine</p>
                </div>
            }
        }
        else { <p>You are in no waiting list.</p>}
    </section>
</body>
</html>

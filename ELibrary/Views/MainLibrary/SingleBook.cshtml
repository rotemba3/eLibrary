@model ELibrary.Models.Books
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>SingleBook</title>
</head>
<body>
    <div id="Book-info" class="popup-book">
        <h3>Book Info</h3>
        <h2>@Model.Title</h2>
        <p>Author: @Model.Authors</p>
        <p>Genre: @Model.Genre</p>
        <p>Price: ₪@Model.Price</p>
        if (@Model.PriceDecrease > 0) //there is a sale
        {
            <p>Price: ₪<del>@Model.Price</del> @(Model.Price - (Model.Price * (Model.PriceDecrease * 0.01)))</p>
        }
        else
        { <p>Price: ₪@Model.Price</p> }
        <p>Description: @Model.Desrip</p> <!--does not need to buy here-->
    </div>
    <div id="Reviews-list">
        <section id="review-block">
            <p></p>
        </section>
    </div>
</body>
</html>

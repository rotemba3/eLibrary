<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~\Content\NavBar.css" /> <!-- הוספת קובץ CSS -->
    <title>@ViewBag.Title ELibrary</title>
    @Styles.Render("~/Content/NavBar.css")
</head>
@if (ViewContext.RouteData.Values["controller"].ToString() != "Login") //so the nav bar wont show where its not needed
{
    <body>
        <nav class="navbar navbar-expand-sm">
            <div class="search-bar">
                <input type="text" placeholder="Type Something..." />
                <button class="search-button">🔍</button>
                <div id="search-results" class="search-results"></div>
            </div>
            <ul class="nav-links">
                <li>@Html.ActionLink("Home", "HomePage", "Home")</li>
                <li>@Html.ActionLink("Library", "Library", "MainLibrary")</li>
                <li>@Html.ActionLink("Profile", "UserProfile", "Profile")</li>
                <li>@Html.ActionLink("Checkout", "CheckOut", "MainLibrary")</li>
            </ul>
            <!-- עיגול הפרופיל -->
            <div class="profile-icon" id="profile-icon">
                <a href="#">
                    <img src="~/Pictures/icons8-user-50.png" alt="Profile" />
                </a>
            </div>
        </nav>
        <!--התחברות חלונית מודאלית -->
        <div id="login-modal" class="modal" style="display: none;">
            <div class="modal-content">
                <span class="close" id="modal-close">&times;</span>
                <h2>Login</h2>
                <form action="/Login/Verify_Login">
                    <!--the action will direct to the Login controller-->
                    <div class="form-group">
                        <label for="username">Username:</label>
                        <input type="text" id="username" placeholder="Enter your username" />
                    </div>
                    <div class="form-group">
                        <label for="password">Password:</label>
                        <input type="password" id="password" placeholder="Enter your password" />
                    </div>
                    <div class="form-group">
                        <button type="button" id="login-button">Login</button>
                    </div>
                    <p><a href="@Url.Action("Register", "Login")">Don't have an account? Register here.</a></p>
                    <p><a href="@Url.Action("ForgotPassword", "Login")">Forgot your password?</a></p>
                </form>
            </div>
            <!-- חלונית פרופיל -->
            <div id="profile-modal" class="modal" style="display: none;">
                <div class="modal-content">
                    <span class="close" id="modal-close">&times;</span>
                    <h2>Profile</h2>
                    <p id="welcome-message">Welcome!</p>
                    <button id="logout-button">Logout</button>
                </div>
            </div>
        </div>
        <script>
            // כאשר הדף נטען
            document.addEventListener('DOMContentLoaded', function () {
                // בדיקת סטטוס התחברות בעת טעינת הדף
                fetch('/Login/IsUserLoggedIn', {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.isLoggedIn) {
                            // אם המשתמש מחובר
                            document.getElementById('login-modal').style.display = 'none'; // מסתיר את חלונית ההתחברות
                            document.getElementById('profile-modal').style.display = 'block'; // מציג את חלונית הפרופיל
                            document.getElementById('welcome-message').textContent = `Welcome, ${data.username}`;
                        } else {
                            // אם המשתמש לא מחובר
                            document.getElementById('login-modal').style.display = 'block'; // מציג את חלונית ההתחברות
                            document.getElementById('profile-modal').style.display = 'none'; // מסתיר את חלונית הפרופיל
                        }
                    })
                    .catch(error => {
                        console.error('Error checking login status:', error);
                    });

                // פתיחת חלונית התחברות בלחיצה על אייקון הפרופיל
                document.getElementById('profile-icon').addEventListener('click', function () {
                    const loginModal = document.getElementById('login-modal');
                    loginModal.style.display = 'block'; // מציג את חלונית ההתחברות

                });

                // סגירת חלונית התחברות בלחיצה על כפתור X
                document.getElementById('modal-close').addEventListener('click', function () {
                    const loginModal = document.getElementById('login-modal');
                    const profileModal = document.getElementById('profile-modal');

                    if (loginModal.style.display === 'block') {
                        loginModal.style.display = 'none'; // מסתיר את חלונית ההתחברות
                    } else if (profileModal.style.display === 'block') {
                        profileModal.style.display = 'none'; // מסתיר את חלונית הפרופיל
                    }
                });
            });

            // התחברות: שליחת פרטים לשרת
            document.getElementById('login-button').addEventListener('click', function () {
                const username = document.getElementById('username').value.trim();
                const password = document.getElementById('password').value.trim();

                if (!username || !password) {
                    alert('Please enter both username and password.');
                    return;
                }

                fetch('/Login/Verify_Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password }) // שולח את הנתונים לשרת
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            alert('Login successful!');
                            document.getElementById('login-modal').style.display = 'none'; // מסתיר את חלונית ההתחברות
                            document.getElementById('profile-modal').style.display = 'block'; // מציג את חלונית הפרופיל
                            document.getElementById('welcome-message').textContent = `Welcome, ${data.username}`;
                        } else {
                            alert(data.message || 'Invalid username or password.');
                        }
                    })
                    .catch(error => {
                        console.error('Error during login:', error);
                        alert('An error occurred while trying to log in.');
                    });
            });

            // Logout: מחיקת קוקי והחזרה לדף ההתחברות
            document.getElementById('logout-button').addEventListener('click', function () {
                fetch('/Login/Logout', { method: 'POST' })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json(); // קבלת תשובה מהשרת
                    })
                    .then(data => {
                        if (data.success) {
                            alert('Logged out successfully.');

                            // עדכון הממשק לאחר ההתנתקות
                            document.getElementById('login-modal').style.display = 'block'; // מציג את חלונית ההתחברות
                            document.getElementById('profile-modal').style.display = 'none'; // מסתיר את חלונית הפרופיל

                            // בדיקה מחודשת אם המשתמש מחובר (לא חובה, אבל מומלץ לאימות)
                            fetch('/Login/IsUserLoggedIn', {
                                method: 'GET',
                                headers: { 'Content-Type': 'application/json' }
                            })
                                .then(response => response.json())
                                .then(statusData => {
                                    if (!statusData.isLoggedIn) {
                                        // וידוא שהמשתמש לא מחובר ומחזירים אותו לחלונית התחברות
                                        document.getElementById('login-modal').style.display = 'block';
                                        document.getElementById('profile-modal').style.display = 'none';
                                    } else {
                                        console.error('Unexpected: User still logged in after logout.');
                                    }
                                })
                                .catch(error => {
                                    console.error('Error during re-checking login status:', error);
                                });
                        } else {
                            alert('Logout failed. Please try again.');
                        }
                    })
                    .catch(error => {
                        console.error('Error during logout:', error);
                        alert('An error occurred while trying to log out.');
                    });
            });
        </script>
    </body>
}
<div>
    @RenderBody()
</div>
</html>

@model ELibrary.Models.Book_and_Reviews
@{
    Layout = "~/Views/Shared/NavBar.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/Content/SingleBook_Style.css" /> <!-- הוספת קובץ CSS -->
    <title>SingleBook</title>
    <style>
        /* כפתורים */
        .Buy&Borrow-Button {
            margin-top: 15px;
        }

        .signup-btn {
            background: #6a11cb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin: 5px;
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

            .signup-btn:hover {
                background: #4a0da9;
            }

        /* עיצוב קישור */
        .Title-link {
            text-decoration: none;
            color: #6a11cb;
            font-weight: bold;
        }

            .Title-link:hover {
                text-decoration: underline;
                color: #4a0da9;
            }
    </style>
</head>
<body>
    <div id="Book-info" class="popup-book">
        <h3>Book Info</h3>
        <h2>@Model.book.Title</h2>
        <p>@Model.book.Cover</p>
        <p>Author: @Model.book.Authors</p>
        <p>Genre: @Model.book.Genre</p>
        <p>Publisher: @Model.book.Publisher</p>
        <p>Published year: @Model.book.PublishYear</p>
        @if (@Model.book.PriceDecrease > 0) //there is a sale
        { 
            <p>Price: ₪<del>@Model.book.Price</del> @(Model.book.Price - (Model.book.Price * (Model.book.PriceDecrease * 0.01)))</p>
        }
        else
        { <p>Price: ₪@Model.book.Price</p>}
        <p>Description: @Model.book.Desrip</p> <!--does not need to buy here-->
    </div>

    <div class="Buy&Borrow-Button">
        <button type="submit" class="signup-btn">Buy</button>
        @if (Model.book.IsBuyOnly == false)
        {<button type="submit" class="signup-btn">Borrow</button>}
    </div>

    <div id="Reviews-list">
        <section id="review-block">
            <h3>Reviews</h3>
            @if (Model.reviews_list != null && Model.reviews_list.Any())
            {
                foreach (var review in Model.reviews_list)
                {
                    <div class="review-item">
                        <p><strong>User:</strong>@review.Username</p>
                        <p><strong>Rating:</strong>@review.Stars/5</p>
                        <p><strong>Review:</strong>@review.Info</p>
                    </div>
                }
            }
            else
            { <p>No reviews avalible for this book.</p>}
        </section>
    </div>
</body>
</html>

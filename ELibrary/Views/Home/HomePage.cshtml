@model IEnumerable<ELibrary.Models.Books>

@{
    ViewBag.Title = "Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/wwwroot/css/HomePage_Style.css" /> <!-- הוספת קובץ CSS -->
    <style>
        .modal {
            display: none; /* מוסתר כברירת מחדל */
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* רקע כהה חצי שקוף */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: #f9f9f9;
            border-radius: 15px;
            padding: 30px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5); /* אפקט צל */
            text-align: center;
            position: relative;
        }

        .close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            color: #888;
        }

            .close:hover {
                color: #000;
            }

        .modal-content h2 {
            font-family: Arial, sans-serif;
            font-size: 2rem;
            margin-bottom: 20px;
            color: #333;
        }

        .modal-content label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }

        .modal-content input {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }

        .modal-content button {
            background-color: #7a6ff0;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: bold;
        }

            .modal-content button:hover {
                background-color: #6956cc;
            }

        .modal-content a {
            color: #7a6ff0;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .modal-content a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <!-- כאן התוכן של כל עמוד -->
    <div class="container">
        <!-- תיאור קצר על השירות -->
        <section class="hero-section">
            <h1>Welcome to Our Library!</h1>
            <p>Explore a wide selection of books, purchase your favorites, and share your feedback.</p>
        </section>

        <!-- הצגת הספרים המומלצים/במבצע -->
        <section class="featured-books">
            <h2>Featured Books</h2>
            <div class="books-container">
                @foreach (var book in Model)
                {
                    <div class="book-item">
                        <h3>@Html.ActionLink(book.Title, "SingleBook", "MainLibrary", new { ISBN = book.ISBN }, new { @class = "Title-link" })</h3>
                        <p>Author: @book.Authors</p>
                        @if (book.PriceDecrease > 0) //there is a sale
                        {
                            <p>Price: ₪<del>@book.Price</del> @(book.Price - (book.Price * (book.PriceDecrease * 0.01)))</p>
                        }
                        else
                        { <p>Price: ₪@book.Price</p>}
                        <p>Genre: @book.Genre</p>
                        <p>Description: @book.Desrip</p> <!--does not need to buy here-->
                    </div>
                }
            </div>
        </section>
    </div>
</body>
</html>

@model ELibrary.Models.Book_and_Reviews
@{
    Layout = "~/Views/Shared/NavBar.cshtml";

}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Review</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            margin: 0;
            padding: 0;
        }

        .review-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            border-left: 5px solid purple;
        }

            .review-container h2 {
                text-align: center;
                color: purple;
                margin-bottom: 20px;
            }

            .review-container label {
                display: block;
                margin: 10px 0 5px;
                color: #333;
                font-weight: bold;
            }

            .review-container input, .review-container select, .review-container textarea {
                width: 100%;
                padding: 10px;
                margin-bottom: 15px;
                border: 1px solid #ccc;
                border-radius: 5px;
                font-size: 14px;
            }

                .review-container input:focus, .review-container select:focus, .review-container textarea:focus {
                    border-color: purple;
                    outline: none;
                    box-shadow: 0 0 5px rgba(128, 0, 128, 0.5);
                }

            .review-container button {
                width: 100%;
                padding: 10px;
                background-color: purple;
                color: white;
                border: none;
                border-radius: 5px;
                font-size: 16px;
                cursor: pointer;
                margin-top: 10px;
            }

                .review-container button:hover {
                    background-color: #6a0dad;
                }

        .review-display {
            margin-top: 20px;
            padding: 15px;
            background-color: #f9f9f9;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

            .review-display h3 {
                color: purple;
                margin-bottom: 10px;
            }

            .review-display p {
                margin: 5px 0;
                color: #555;
            }
    </style>
</head>
<body>
    <div class="review-container">
        <h2>Write a Review</h2>
        @using (Html.BeginForm("AddReview", "MainLibrary", FormMethod.Post))
        {
            <!-- Hidden input to submit ISBN value along with the review -->
            @Html.Hidden("ISBN", Model.book.ISBN)

            <label for="stars">Stars</label>
            <select id="stars" name="Stars" required>
                <option value="">Select rating</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>

            <label for="info">Review</label>
            <textarea id="info" name="Info" rows="5" placeholder="Write your review here..." required></textarea>

            <button type="submit">Submit Review</button>
        }
    </div>
</body>
</html>

